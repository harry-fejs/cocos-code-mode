# Protected relay qualification environment.
# LAN address detected for this workstation: 192.168.20.100.
# Do not commit real member credentials, private keys, or bearer tokens.

# Gateway local origin. The protected client intentionally permits insecure HTTP only on loopback.
# Production and LAN deployments must use HTTPS with a trusted certificate.
CCP_GATEWAY_ORIGIN=http://127.0.0.1:8787
CCP_ALLOW_INSECURE_GATEWAY=1
CCP_PROJECT_ID=replace-with-opaque-project-id
CCP_MEMBER_CREDENTIAL=replace-with-short-lived-eddsa-member-jwt
CCP_APPROVED_DEVICE_ID=replace-after-enrollment
CCP_APPROVED_DEVICE_KEY_ID=replace-after-enrollment
CCP_EXECUTION_KEY_ID=execution-dev-1
CCP_EXECUTION_PUBLIC_KEY=replace-with-base64url-ed25519-spki
CCP_DEVICE_LABEL=replace-with-human-readable-device-label
# Optional override; defaults to %USERPROFILE%\.ccp\identity\device-identity-v1.json.
# CCP_DEVICE_IDENTITY_PATH=C:\path\to\device-identity-v1.json

# Admin-only Gateway device/grant operations; never reuse or commit this credential.
CCP_ADMIN_CREDENTIAL=replace-with-short-lived-admin-eddsa-member-jwt
CCP_GRANT_DEVICE_ID=replace-with-approved-device-uuid
CCP_GRANT_PROJECT_ID=replace-with-opaque-project-id
CCP_GRANT_OPERATION_CLASS=read
# Optional: CCP_GRANT_MEMBER_ID, CCP_GRANT_TOOL_ID, CCP_GRANT_EXPIRES_AT_MS

# One-command local qualification orchestrator.
# Requires CCP_MEMBER_CREDENTIAL; admin fields are optional and remain explicit.
# CCP_ADMIN_CREDENTIAL=replace-with-short-lived-admin-eddsa-member-jwt

# Safe readiness report; prints only configured/missing booleans and the next blocked gate.
# node .\scripts\qualify-protected.js --status

# Signed release origin. Must be HTTPS and serve the complete immutable release set.
CCP_RELEASE_ORIGIN=https://192.168.20.100:8788/
CCP_RELEASE_HOST=192.168.20.100
CCP_RELEASE_PORT=8788
CCP_RELEASE_DIRECTORY=C:\ccp-release
CCP_RELEASE_TLS_CERT=C:\certs\192.168.20.100+2.pem
CCP_RELEASE_TLS_KEY=C:\certs\192.168.20.100+2-key.pem
CCP_RELEASE_CHANNEL=stable
CCP_RELEASE_ROOT_PATH=replace-with-local-root.json
CCP_RELEASE_ROOT_SHA256=replace-with-sha256-of-root-json-bytes

# Release assembly requires the signed root wrapper separately from the canonical root payload.
CCP_RELEASE_ROOT_METADATA_PATH=replace-with-signed-root-metadata-json
CCP_RELEASE_ZIP=replace-with-built-release-zip

# CCP_RELEASE_ROOT_PATH is the canonical unsigned root payload used for bootstrap pinning.
# CCP_RELEASE_ROOT_METADATA_PATH is the signed wrapper served by the release origin.
