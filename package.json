{
  "$schema": "./@types/schema/package/index.json",
  "package_version": 2,
  "name": "ccp3x",
  "version": "2.1.0",
  "author": "cst by hzi for cc3.7",
  "editor": ">=3.7.0",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.js",
    "build": "node ./scripts/check-package-scripts.js && node ./scripts/generate-build-info.js && npx tsc && node ./scripts/copy-cocos-graph-runtime.js && node ./scripts/cocos-api/copy-runtime-catalog.js && node ./scripts/cocos-api/copy-validation-runtime.js && node scripts/check-creator-load.js",
    "build:debug": "npm run build && node scripts/minify-debug.js && node scripts/check-creator-load.js",
    "gen:catalog": "node ./scripts/generate-tool-catalog.js",
    "package": "npm run build && node ./scripts/package.js",
    "link:project": "node ./scripts/link-project-extension.js",
    "link:plans": "python ../../../_devtools/cfg-n-scripts/notes/08_System/mount_project_plans.py --here",
    "test:unit": "node --test --test-concurrency=1 tests/unit/*.test.js",
    "test": "npm run test:unit",
    "test:live": "node --test --test-concurrency=1 tests/live/*.test.js tests/live/ui/*.test.js",
    "test:all": "node --test --test-concurrency=1 tests/unit/*.test.js tests/live/*.test.js tests/live/ui/*.test.js",
    "check:creator-load": "node scripts/check-creator-load.js",
    "session:run": "node scripts/session-presence/cli.js",
    "session:stdio": "node scripts/session-presence/stdio.js",
    "test:session": "node --test tests/unit/session-presence.test.js tests/unit/ccp-session.test.js tests/unit/ccp-session-supervisor.test.js tests/unit/ccp-session-host.test.js tests/unit/ccp-session-manager.test.js",
    "audit:portfolio": "node scripts/audit-tool-portfolio.js",
    "audit:live": "node scripts/audit-live-qualification.js",
    "audit:portfolio:ready": "node scripts/audit-tool-portfolio.js --require-ready"
  },
  "description": "i18n:ccp3x.description",
  "main": "./dist/main.js",
  "dependencies": {
    "@types/sharp": "^0.31.1",
    "@utcp/http": "^1.1.0",
    "@utcp/sdk": "^1.1.0",
    "cors": "^2.8.6",
    "express": "4.21.2",
    "fs-extra": "^10.0.0",
    "sharp": "0.30.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cocos/creator-types": "^3.8.7",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/fs-extra": "^9.0.5",
    "@types/node": "^18.17.1",
    "archiver": "^8.0.0",
    "terser": "5.44.0",
    "typescript": "^5.8.2"
  },
  "panels": {
    "status": {
      "title": "CCP 3x Status",
      "type": "dockable",
      "main": "dist/panels/status",
      "size": {
        "min-width": 320,
        "min-height": 240,
        "width": 450,
        "height": 680
      }
    },
    "prompt": {
      "title": "Agent Inbox",
      "type": "dockable",
      "main": "dist/panels/prompt",
      "size": {
        "min-width": 320,
        "min-height": 240,
        "width": 480,
        "height": 560
      }
    },
    "configuration": {
      "title": "Settings",
      "type": "dockable",
      "main": "dist/panels/configuration",
      "size": {
        "min-width": 400,
        "min-height": 300,
        "width": 560,
        "height": 680
      }
    },
    "preview": {
      "title": "Asset Preview",
      "type": "dockable",
      "main": "dist/panels/preview",
      "size": {
        "min-width": 200,
        "min-height": 200,
        "width": 400,
        "height": 400
      }
    }
  },
