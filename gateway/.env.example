# Gateway process: mounts only the member JWT public key and signer socket.
DTX_MEMBER_JWT_PUBLIC_KEY_PATH=/run/secrets/member-jwt-public.pem
DTX_MEMBER_JWT_ISSUER=mcpdocs
# Set an audience after the neutral identity issuer adds aud to every token.
# DTX_MEMBER_JWT_AUDIENCE=dtx-tools
# Docker-only: the container listens on all container interfaces; Compose
# publishes only host 127.0.0.1. Native processes keep loopback and omit the flag.
# Production uses a TLS reverse proxy and a trusted member issuer.
CCP_GATEWAY_HOST=0.0.0.0
CCP_GATEWAY_CONTAINER_LOOPBACK=1
CCP_GATEWAY_PORT=8787
CCP_GATEWAY_PUBLISH_PORT=8787
CCP_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.20.100

# Release-admin verification keys are public trust anchors only.
# Set the PEM values through the deployment secret manager; do not commit them.
CCP_RELEASE_TARGETS_KEY_ID=release-targets
# CCP_RELEASE_TARGETS_PUBLIC_KEY_PEM=
CCP_RELEASE_POLICY_KEY_ID=rollout-policy
# CCP_RELEASE_POLICY_PUBLIC_KEY_PEM=
CCP_RELEASE_TARGETS_THRESHOLD=1
CCP_RELEASE_POLICY_THRESHOLD=1
CCP_DB_PATH=/var/lib/ccp/ccp.db
CCP_EXECUTION_KEY_ID=execution-prod-1
CCP_SIGNER_SOCKET=/run/ccp/signer.sock
CCP_IP_REQUESTS_PER_MINUTE=240
CCP_MEMBER_REQUESTS_PER_MINUTE=120
CCP_MAX_TRACKED_RATE_KEYS=10000
CCP_MAX_CONCURRENT_EXECUTE=64
CCP_MAX_QUEUED_EXECUTE=128
CCP_QUEUE_TIMEOUT_MS=1000

# Signer process only: do not provide this path to the Gateway process.
CCP_SIGNER_PRIVATE_KEY_PATH=/run/secrets/execution-private.pem
CCP_SIGNER_MAX_PER_SECOND=1000

# Development/test only. Production ignores in-process PKCS8 unless explicitly enabled.
# CCP_ALLOW_MEMORY_SIGNER=1
# CCP_EXECUTION_PRIVATE_KEY_PKCS8=
